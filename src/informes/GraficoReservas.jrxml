	<parameter name="p_nombre_restaurante" class="java.lang.String"/>
	<parameter name="p_direccion_restaurante" class="java.lang.String"/>
	<parameter name="p_telefono_restaurante" class="java.lang.String"/>
	<parameter name="fechaInicio6Meses" class="java.lang.String">
		<defaultValueExpression><![CDATA[new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm:ss").format(new java.util.Date(new java.util.Date().getTime() - 183L * 24 * 60 * 60 * 1000))]]></defaultValueExpression>
	</parameter>
	<parameter name="p_id_restaurante" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[2]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[SELECT 
    DATE_FORMAT(fecha_hora, '%b %Y') AS mes,
    estado_reserva,
    COUNT(*) AS total
FROM servix.reserva
WHERE 
    servix.reserva.fecha_hora >= $P{fechaInicio6Meses}
    AND estado_reserva IN ('confirmada', 'cancelada')
    AND id_restaurante = $P{p_id_restaurante}
GROUP BY DATE_FORMAT(fecha_hora, '%Y-%m'), 
estado_reserva, DATE_FORMAT(fecha_hora, '%b %Y')]]>
	</queryString>
