		<property name="com.jaspersoft.studio.field.name" value="mes"/>
		<property name="com.jaspersoft.studio.field.label" value="mes"/>
	</field>
	<field name="estado_reserva" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="estado_reserva"/>
		<property name="com.jaspersoft.studio.field.label" value="estado_reserva"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="reserva"/>
	</field>
	<field name="total" class="java.lang.Long">
		<property name="com.jaspersoft.studio.field.name" value="total"/>
		<property name="com.jaspersoft.studio.field.label" value="total"/>
	</field>
